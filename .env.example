# ConduzAPP — variáveis de ambiente (modelo; NUNCA coloque valores reais aqui).
# Copie para .env.local (ignorado pelo Git) ou cadastre no painel do serviço
# (Vercel, EAS, Firebase). Valores reais ficam fora do repositório.

# ---------------------------------------------------------------------------
# App (web e celular) — variáveis EXPO_PUBLIC_ vão para o código do navegador.
# A configuração web do Firebase é pública por natureza (identifica o projeto);
# a segurança vem das regras do Firestore/Storage e da Function autenticada.
# ---------------------------------------------------------------------------

# "emulator" (padrão, emuladores locais) ou "cloud-demo" (projeto Firebase real).
EXPO_PUBLIC_FIREBASE_MODE=emulator

# Só no modo cloud-demo (Console Firebase > Configurações do projeto > Seus apps > Web).
EXPO_PUBLIC_FIREBASE_API_KEY=PREENCHA
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=SEU-PROJETO.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=SEU-PROJETO
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=SEU-PROJETO.firebasestorage.app
EXPO_PUBLIC_FIREBASE_APP_ID=PREENCHA

# Só no modo emulator, para abrir no celular pela mesma rede Wi-Fi:
# IP do computador na rede local (ipconfig > Endereço IPv4). Padrão: 127.0.0.1.
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Backend (Cloud Function `conduz`) — arquivo functions/.env.SEU-PROJETO,
# gerado por scripts/configure-cloud.cjs. Não são segredos, mas são por projeto.
# ---------------------------------------------------------------------------
CONDUZ_MODE=cloud-demo
CONDUZ_PROJECT_ID=SEU-PROJETO
CONDUZ_STORAGE_BUCKET=SEU-PROJETO.firebasestorage.app
CONDUZ_DEMO_SCOPE=demo-tcc-2026

# Chaves de conta de serviço (serviceAccountKey.json, *firebase-adminsdk*.json)
# NÃO são necessárias: o deploy usa o login da Firebase CLI e a Function usa a
# identidade gerenciada do Google Cloud. Se algum dia precisar de uma, ela já é
# bloqueada pelo .gitignore e nunca deve ser commitada.
