{
  "expo": {
    "name": "ConduzAPP",
    "slug": "conduzapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "conduzapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "br.com.conduzapp"
    },
    "android": {
      "package": "br.com.conduzapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "ConduzAPP",
      "shortName": "ConduzAPP",
      "description": "Aulas de direção com instrutores credenciados.",
      "lang": "pt-BR",
      "themeColor": "#1E2A78",
      "backgroundColor": "#F4F7FB"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Marketplace que conecta alunos da CNH a instrutores autônomos credenciados: aulas avulsas de 50 minutos, agenda, pagamento e avaliação."
  }
}
