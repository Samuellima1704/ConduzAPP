    "emulators": "firebase emulators:start --project demo-conduzapp",
    "admin": "node scripts/tornar-admin.cjs",
    "test:e2e": "node scripts/testar-tudo.cjs",
    "carga:teste": "node scripts/carga-teste.cjs",
